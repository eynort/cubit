# Copia esto a .env y cámbialo (./up.sh lo crea solo la primera vez).
# Solo para el primer arranque: después, todo se cambia en el panel web
# (Ajustes) y se guarda en bot-data/bot.json.

# El bot
BOT_NAME=Test_Bot
OWNER=TuNombre              # quién le manda órdenes por /msg (y op en el servidor local)

# El servidor: "minecraft" es el local de este compose (vanilla, modo offline).
# Para uno de verdad: SERVER=play.ejemplo.net y quita "local" de COMPOSE_PROFILES.
SERVER=minecraft
MC_VERSION=26.2
MC_PORT=25565

# La IA: Ollama aquí mismo con gemma4 (quita "ai" de COMPOSE_PROFILES y pon
# AI_URL= para ir sin IA, o AI_API=openai + AI_URL + AI_KEY para otra).
AI_MODEL=gemma4:e4b
AI_URL=http://ollama:11434
AI_API=ollama
AI_KEY=
# Dónde guarda Ollama los modelos: un volumen de Docker, o tu carpeta de
# Ollama para no volver a descargarlos (./up.sh la pone sola si existe).
OLLAMA_MODELS=ollama

PANEL_PORT=8080
# la consola del servidor local (./up.sh pone una al azar)
RCON_PASSWORD=
# Discord/Slack, para los avisos
WEBHOOK=

COMPOSE_PROFILES=local,ai
