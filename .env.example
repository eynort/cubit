# Copia esto a .env y cámbialo (./up.sh lo crea solo la primera vez).
# Los bots se crean y se configuran en el panel web; aquí solo lo de Docker.

# Tu nombre de jugador: el asistente lo propone como dueño de los bots, y en
# el servidor de pruebas eres op
OWNER=TuNombre

# El servidor de pruebas (vanilla, modo offline)
MC_VERSION=26.2
MC_PORT=25565

# El panel
PANEL_PORT=8080
# la consola del servidor de pruebas (./up.sh pone una al azar)
RCON_PASSWORD=

# "local" levanta el servidor de pruebas; sin él, solo el hub (para bots en
# servidores de fuera)
COMPOSE_PROFILES=local

# La IA local (Ollama), encendida por defecto. La primera vez baja el modelo
# (~4,6 GB; necesita ~3-4 GB de RAM libre). Otras opciones: gemma4:e4b (más
# lista, más RAM), qwen3:4b. Cada bot la apaga en Ajustes del panel.
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
