# ViaProxy (https://github.com/ViaVersion/ViaProxy): deja que los bots entren en
# servidores de otras versiones de Minecraft. Un solo proceso para todos los
# servidores: el destino y la versión los dice el bot en el handshake
# (--wildcard-domain-handling public). Versión fijada abajo.
FROM eclipse-temurin:21.0.5_11-jre-jammy
ARG VIAPROXY_VERSION=3.4.14
# (al cambiar la versión, cambia también el sha256 de abajo)
ADD --checksum=sha256:2894bbfb2f4342f8fde887af6c689313efd5b0e46a8006775eea0e21e2948ab5 https://github.com/ViaVersion/ViaProxy/releases/download/v${VIAPROXY_VERSION}/ViaProxy-${VIAPROXY_VERSION}.jar /app/ViaProxy.jar
WORKDIR /app/run
# VIAPROXY_AUTH: none (servidores sin premium) o account (con la cuenta de
# Microsoft que se añade una vez: "account add microsoft" en la consola)
ENV VIAPROXY_AUTH=none
EXPOSE 25568
ENTRYPOINT ["/bin/sh", "-c", "exec java -Xmx192m -jar /app/ViaProxy.jar cli --bind-address 0.0.0.0:25568 --wildcard-domain-handling public --auth-method ${VIAPROXY_AUTH}"]
